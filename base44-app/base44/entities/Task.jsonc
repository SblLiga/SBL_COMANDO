      "title": "\u05de\u05d6\u05d4\u05d4 \u05d9\u05e2\u05d3"
    },
    "title": {
      "type": "string",
      "title": "\u05db\u05d5\u05ea\u05e8\u05ea \u05de\u05e9\u05d9\u05de\u05d4"
    },
    "order_index": {
      "type": "number",
      "default": 0,
      "title": "\u05e1\u05d3\u05e8"
    },
    "is_completed": {
      "type": "boolean",
      "default": false,
      "title": "\u05d4\u05d5\u05e9\u05dc\u05dd"
    },
    "priority": {
      "type": "string",
      "enum": [
        "\u05d3\u05d7\u05d5\u05e3",
        "\u05d1\u05d9\u05e0\u05d5\u05e0\u05d9",
        "\u05e0\u05de\u05d5\u05da"
      ],
      "default": "\u05d1\u05d9\u05e0\u05d5\u05e0\u05d9",
      "title": "\u05e2\u05d3\u05d9\u05e4\u05d5\u05ea"
    },
    "xp_value": {
      "type": "number",
      "default": 100,
      "title": "\u05e2\u05e8\u05da XP"

{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "manager",
        "user"
      ],
      "default": "user",
      "title": "\u05ea\u05e4\u05e7\u05d9\u05d3"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05de\u05e0\u05d5\u05d9"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female"
      ],
      "title": "\u05de\u05d2\u05d3\u05e8"
    },
    "target": {
      "type": "string",
      "title": "\u05ea\u05d7\u05d5\u05dd \u05d9\u05e2\u05d3"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false,
      "title": "\u05d4\u05e9\u05dc\u05de\u05ea onboarding"
    },
    "group_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05e7\u05d1\u05d5\u05e6\u05d4"
    },
    "focus_target": {
      "type": "string",
      "title": "\u05d9\u05e2\u05d3 \u05de\u05d9\u05e7\u05d5\u05d3 \u05d7\u05d5\u05d3\u05e9\u05d9 (\u05de\u05e0\u05d4\u05dc)"
    },
    "focus_month": {
      "type": "string",
      "title": "\u05d7\u05d5\u05d3\u05e9 \u05d9\u05e2\u05d3 \u05de\u05d9\u05e7\u05d5\u05d3"
    }
  },
  "required": []
}
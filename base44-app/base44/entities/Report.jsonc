{
  "name": "Report",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "weekly",
        "monthly",
        "progress",
        "anomaly"
      ],
      "default": "weekly",
      "title": "\u05e1\u05d5\u05d2 \u05d3\u05d5\u05d7"
    },
    "status": {
      "type": "string",
      "enum": [
        "approved",
        "pending",
        "rejected"
      ],
      "default": "pending",
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1"
    },
    "submitted_by": {
      "type": "string",
      "title": "\u05d4\u05d5\u05d2\u05e9 \u05e2\u05dc \u05d9\u05d3\u05d9"
    },
    "content": {
      "type": "string",
      "title": "\u05ea\u05d5\u05db\u05df"
    },
    "group_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05e7\u05d1\u05d5\u05e6\u05d4"
    }
  },
  "required": [
    "type",
    "submitted_by"
  ]
}
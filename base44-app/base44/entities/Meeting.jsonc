{
  "name": "Meeting",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05e7\u05d1\u05d5\u05e6\u05d4"
    },
    "group_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05e7\u05d1\u05d5\u05e6\u05d4"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date-time",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d5\u05e9\u05e2\u05d4"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "live",
        "completed"
      ],
      "default": "scheduled",
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1"
    },
    "current_section": {
      "type": "number",
      "default": 0,
      "title": "\u05e1\u05e2\u05d9\u05e3 \u05e0\u05d5\u05db\u05d7\u05d9"
    },
    "summary": {
      "type": "string",
      "title": "\u05e1\u05d9\u05db\u05d5\u05dd \u05e4\u05d2\u05d9\u05e9\u05d4"
    },
    "section_reports": {
      "type": "string",
      "title": "\u05d3\u05d5\u05d7\u05d5\u05ea \u05e1\u05e2\u05d9\u05e4\u05d9\u05dd (JSON)"
    },
    "duration_minutes": {
      "type": "number",
      "default": 90,
      "title": "\u05de\u05e9\u05da (\u05d3\u05e7\u05d5\u05ea)"
    },
    "is_locked": {
      "type": "boolean",
      "default": false,
      "title": "\u05e0\u05e2\u05d5\u05dc (\u05e0\u05e9\u05dc\u05d7 \u05dc\u05d0\u05d3\u05de\u05d9\u05df)"
    }
  },
  "required": [
    "group_name"
  ]
}
{
  "name": "Member",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05de\u05dc\u05d0"
    },
    "avatar_url": {
      "type": "string",
      "title": "\u05ea\u05de\u05d5\u05e0\u05ea \u05e4\u05e8\u05d5\u05e4\u05d9\u05dc"
    },
    "xp": {
      "type": "number",
      "default": 0,
      "title": "\u05e0\u05e7\u05d5\u05d3\u05d5\u05ea XP"
    },
    "streak": {
      "type": "number",
      "default": 0,
      "title": "\u05e8\u05e6\u05e3 \u05d9\u05de\u05d9\u05dd"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female"
      ],
      "title": "\u05de\u05d2\u05d3\u05e8"
    },
    "target": {
      "type": "string",
      "title": "\u05ea\u05d7\u05d5\u05dd \u05d9\u05e2\u05d3"
    },
    "group_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05e7\u05d1\u05d5\u05e6\u05d4"
    },
    "group_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05e7\u05d1\u05d5\u05e6\u05d4"
    },
    "progress": {
      "type": "number",
      "default": 0,
      "title": "\u05d4\u05ea\u05e7\u05d3\u05de\u05d5\u05ea (%)"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u05d1\u05e2\u05e7\u05d1\u05d5\u05ea",
        "\u05d3\u05e8\u05d5\u05e9\u05d4 \u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5\u05ea",
        "\u05e7\u05e8\u05d9\u05d8\u05d9",
        "\u05dc\u05d0 \u05e4\u05e2\u05d9\u05dc"
      ],
      "default": "\u05d1\u05e2\u05e7\u05d1\u05d5\u05ea",
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "manager",
        "admin"
      ],
      "default": "user",
      "title": "\u05ea\u05e4\u05e7\u05d9\u05d3"
    },
    "is_current_user": {
      "type": "boolean",
      "default": false,
      "title": "\u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d4\u05e0\u05d5\u05db\u05d7\u05d9"
    },
    "goal_title": {
      "type": "string",
      "title": "\u05db\u05d5\u05ea\u05e8\u05ea \u05d9\u05e2\u05d3"
    },
    "goal_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05d9\u05e2\u05d3"
    },
    "goal_hidden": {
      "type": "boolean",
      "default": false,
      "title": "\u05d9\u05e2\u05d3 \u05d7\u05e1\u05d5\u05d9"
    },
    "user_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05de\u05e9\u05ea\u05de\u05e9 \u05de\u05e7\u05d5\u05e9\u05e8"
    },
    "next_month_target": {
      "type": "string",
      "title": "\u05d9\u05e2\u05d3 \u05dc\u05d7\u05d5\u05d3\u05e9 \u05d4\u05d1\u05d0"
    },
    "next_month_selected_at": {
      "type": "string",
      "format": "date-time",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d1\u05d7\u05d9\u05e8\u05ea \u05d9\u05e2\u05d3 \u05dc\u05d7\u05d5\u05d3\u05e9 \u05d4\u05d1\u05d0"
    }
  },
  "required": [
    "name"
  ]
}
# Application
APP_ENV=dev
LOG_LEVEL=DEBUG
PORT=8000

# PostgreSQL (RDS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sbl_dev
DB_USER=sbl_admin
DB_PASSWORD=change_me
DB_SSLMODE=prefer
RUN_DB_MIGRATIONS=true

# DEV only: auto-seed sample users/goals on first startup
SEED_DEV_DATA=true
DEV_ADMIN_PASSWORD=Admin123!

# PROD only: secure admin bootstrap (never hardcode in code)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional Amazon SES (leave empty in DEV — OTP returned as dev_otp in API)
MAIL_FROM=
APP_PUBLIC_URL=http://localhost:8000

# GROW payments (wire real values tomorrow)
GROW_WEBHOOK_SECRET=
GROW_PAYMENT_URL=https://grow.co.il/subscribe

# Auth
JWT_SECRET=replace_with_secure_value
JWT_EXPIRES_MINUTES=60

# Cloud note: in Elastic Beanstalk these are injected by Terraform/Secrets Manager.
# DB_SECRET_ARN=arn:aws:secretsmanager:us-east-1:...
# DB_SSLMODE=require

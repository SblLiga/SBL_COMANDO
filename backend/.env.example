# Local Docker / laptop ONLY — never commit real values.
# Cloud (Elastic Beanstalk) loads secrets from AWS Secrets Manager via:
#   DB_SECRET_ARN  → RDS password
#   APP_SECRET_ARN → jwt_secret, mail_from, grow_*, admin_*
#
# Company ops: terraform/scripts/upsert-app-secrets.ps1

APP_ENV=dev
LOG_LEVEL=INFO
PORT=8000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=sbl_dev
DB_USER=sbl_admin
DB_PASSWORD=change_me
DB_SSLMODE=prefer
RUN_DB_MIGRATIONS=true

SEED_DEV_DATA=true

# Prefer leaving these empty locally; use Secrets Manager in AWS.
JWT_SECRET=replace_with_secure_value_for_local_docker_only
JWT_EXPIRES_MINUTES=60
ADMIN_EMAIL=
ADMIN_PASSWORD=
MAIL_FROM=
GROW_WEBHOOK_SECRET=
GROW_PAYMENT_URL=https://meshulam.co.il/s/180deaa3-f766-9c23-5820-a8a91ea5a1ff
# Make.com — leave empty until the Make scenario webhook URL is known
MAKE_WEBHOOK_SECRET=
MAKE_TRIGGER_URL=
MAKE_PAYMENT_URL=
# Temporary: show OTP on screen + accept 000000 until SES works for all recipients
ALLOW_OTP_SCREEN_FALLBACK=true

# Cloud-only (set by Terraform / upsert-app-secrets.ps1 — not for git):
# DB_SECRET_ARN=arn:aws:secretsmanager:...
# APP_SECRET_ARN=arn:aws:secretsmanager:...

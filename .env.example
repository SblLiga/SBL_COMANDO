APP_ENV=dev
LOG_LEVEL=INFO
PORT=8000

# Database (RDS/Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sbl_dev
DB_USER=sbl_admin
DB_PASSWORD=change_me
DB_SSLMODE=prefer
RUN_DB_MIGRATIONS=true

# Auth / application secrets
JWT_SECRET=replace_with_secure_value
JWT_EXPIRES_MINUTES=60

# Production bootstrap admin (must be set via secret manager/SSM, never hardcoded)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_secure_password

# Base44 frontend integration (for base44-app only)
VITE_BASE44_APP_ID=your_base44_app_id
VITE_BASE44_APP_BASE_URL=https://your-app.base44.app
VITE_BASE44_FUNCTIONS_VERSION=latest

APP_ENV=dev
LOG_LEVEL=INFO
PORT=8000

# Database (RDS/Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sbl_dev
DB_USER=sbl_admin
DB_PASSWORD=change_me
DB_SSLMODE=prefer
RUN_DB_MIGRATIONS=true

# DEV only: auto-seed sample users/goals on first startup
SEED_DEV_DATA=true
DEV_ADMIN_PASSWORD=Admin123!

# Auth / application secrets
JWT_SECRET=replace_with_secure_value
JWT_EXPIRES_MINUTES=60

# PROD only: secure admin bootstrap (must come from AWS secrets/SSM)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Base44 frontend integration (for base44-app only)
VITE_BASE44_APP_ID=your_base44_app_id
VITE_BASE44_APP_BASE_URL=https://your-app.base44.app
VITE_BASE44_FUNCTIONS_VERSION=latest
